# Patent Search Engine 配置模板
# ================================
# 复制此文件为 config.env 并填入您的 API Key
# 用法: cp config.env.template config.env

# Lens.org API (推荐 - 全球专利覆盖)
# 注册: https://www.lens.org/lens/user/register
# 免费: 1000次/月
LENS_API_KEY=

# Google Custom Search API (可选)
# 配置: https://console.cloud.google.com/apis/credentials
# 需要: 启用 Custom Search API + 创建搜索引擎
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Google BigQuery (可选 - 76M+ 美国专利)
# 配置: https://console.cloud.google.com/
# 需要: 创建项目 + 启用 BigQuery API + 服务账号
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# EPO OPS (可选 - 欧洲专利)
# 注册: https://developers.epo.org/
# 需要: OAuth2 认证
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
